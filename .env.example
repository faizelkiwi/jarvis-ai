# ─── Required in production ───────────────────────────────────────────────
# PostgreSQL connection (Supabase: Project Settings → Database → Connection string, "Session pooler").
# Leave unset in development to use the embedded database in .data/pglite.
DATABASE_URL=

# 32-byte key that encrypts stored API credentials. Generate: openssl rand -hex 32
# Keep it safe — losing it makes stored credentials unreadable.
JARVIS_ENCRYPTION_KEY=

# Protects /api/cron/worker (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=

# ─── AI providers (optional here — can also be entered in Integrations) ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Behaviour ────────────────────────────────────────────────────────────
# true = offline placeholder AI, clearly flagged in the UI. Never use in production.
JARVIS_DEMO_MODE=false
# Run the background worker inside the web server process (dev / single server).
JARVIS_INPROCESS_WORKER=true
# Apply migrations automatically on start when DATABASE_URL is set (otherwise run `npm run db:migrate`).
JARVIS_AUTO_MIGRATE=false
DATABASE_POOL_SIZE=5
